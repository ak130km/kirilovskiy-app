# ════════════════════════════════════════════════════════════════════
#  Кондитерская Артёма Кирилловского — переменные окружения
#  Скопируйте файл:  cp .env.example .env
#  Настоящие ключи НЕ коммитьте: .env в .gitignore.
# ════════════════════════════════════════════════════════════════════

NODE_ENV=development
TZ=Europe/Moscow

# ─── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=kirilovskiy
POSTGRES_PASSWORD=kirilovskiy
POSTGRES_DB=kirilovskiy
POSTGRES_PORT=5432
# Для запуска API на хосте (в Docker Compose адрес подставляется автоматически)
DATABASE_URL=postgresql://kirilovskiy:kirilovskiy@localhost:5432/kirilovskiy?schema=public

# ─── API (NestJS) ─────────────────────────────────────────────────────
API_PORT=4000
# Публичный адрес API: используется в ссылках для банка (callback). Для телефона в локальной сети — IP компьютера
API_PUBLIC_URL=http://localhost:4000
# Разрешённые origin через запятую; пусто — разрешены все (только для разработки)
CORS_ORIGINS=
# Секреты JWT — в production обязательно длинные случайные строки (openssl rand -base64 48)
JWT_CUSTOMER_SECRET=dev-customer-secret-change-me
JWT_STAFF_SECRET=dev-staff-secret-change-me
JWT_CUSTOMER_EXPIRES_IN=90d
JWT_STAFF_EXPIRES_IN=12h
# Каталог для загруженных фото товаров
UPLOADS_DIR=uploads
# Схема deep link мобильного приложения (возврат после оплаты)
MOBILE_APP_SCHEME=kirilovskiy

# ─── Начальные данные (seed) ──────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@kirilovskiy.local
# Только для локальной разработки. Если пусто — пароль сгенерируется и выведется в лог
SEED_ADMIN_PASSWORD=admin12345
# Демо-каталог, зоны, интервалы, промокоды и демо-сотрудники
SEED_DEMO_DATA=true
# Применять миграции и сиды при старте контейнера API
SEED_ON_START=true

# ─── Адаптеры интеграций ──────────────────────────────────────────────
# Оплата: test | alfabank
PAYMENT_PROVIDER=test
# Курьерская служба: test | yandex
COURIER_PROVIDER=test
# Учётная система: noop | onec
ACCOUNTING_PROVIDER=noop
# Push-уведомления: log | expo
PUSH_PROVIDER=log

# Альфа-Банк (интернет-эквайринг, карта и СБП). Тестовый стенд: https://alfa.rbsuat.com/payment/rest
ALFABANK_API_URL=https://alfa.rbsuat.com/payment/rest
ALFABANK_USERNAME=
ALFABANK_PASSWORD=
ALFABANK_TOKEN=
ALFABANK_RETURN_URL=
ALFABANK_CALLBACK_SECRET=

# Яндекс Доставка (claims API v2)
YANDEX_DELIVERY_API_URL=https://b2b.taxi.yandex.net
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_SOURCE_ADDRESS=
YANDEX_DELIVERY_SOURCE_LAT=
YANDEX_DELIVERY_SOURCE_LON=
YANDEX_DELIVERY_CONTACT_PHONE=

# 1С:УНФ (HTTP-сервис публикации базы)
ONEC_BASE_URL=
ONEC_USER=
ONEC_PASSWORD=

# Telegram-бот для уведомлений сотрудников (пусто — сообщения пишутся в лог)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Expo Push (токен необязателен, нужен при включённой защите push в аккаунте Expo)
EXPO_ACCESS_TOKEN=

# ─── Админ-панель (Next.js) ───────────────────────────────────────────
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Мобильное приложение (Expo) ──────────────────────────────────────
# Пусто — приложение само возьмёт IP компьютера, на котором запущен Metro (порт 4000)
EXPO_PUBLIC_API_URL=
# ID проекта EAS (нужен для Expo push-токенов и сборок): npx eas-cli init
EAS_PROJECT_ID=
