// Схема базы данных «Кондитерская Артёма Кирилловского».
// Все денежные суммы хранятся в копейках (Int).
// Моменты времени — в UTC, дата доставки — тип date (день по Москве).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Перечисления ───────────────────────────

enum OrderStatus {
  NEW // новый
  CONFIRMED // подтверждён
  PREPARING // готовится
  READY // готов
  HANDED_TO_COURIER // передан курьеру
  COMPLETED // выполнен
  CANCELLED // отменён
}

enum FulfillmentType {
  DELIVERY // доставка
  PICKUP // самовывоз
}

enum PaymentMethod {
  CARD // банковская карта
  SBP // Система быстрых платежей
}

enum PaymentStatus {
  PENDING // ожидает оплаты
  SUCCEEDED // оплачен
  FAILED // ошибка оплаты
  CANCELLED // платёж отменён
  REFUNDED // возврат
}

enum StaffRole {
  ADMIN // полный доступ
  MANAGER // заказы, каталог, промокоды, доставка
  OPERATOR // заказы и стоп-лист
}

enum PromoCodeType {
  PERCENT // процент от суммы товаров
  FIXED // фиксированная сумма в копейках
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationChannel {
  PUSH
  TELEGRAM
  SMS
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
  INTEGRATION
}

// ─────────────────────────── Клиенты ───────────────────────────

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String    @unique // +7XXXXXXXXXX
  name        String?
  email       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  orders  Order[]
  devices Device[]

  @@map("customers")
}

// Одноразовые коды входа по SMS (храним только хэш)
model AuthCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("auth_codes")
}

// Устройство с Expo push-токеном (есть и у гостей)
model Device {
  id            String         @id @default(uuid()) @db.Uuid
  expoPushToken String         @unique @map("expo_push_token")
  platform      DevicePlatform
  customerId    String?        @map("customer_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders   Order[]

  @@index([customerId])
  @@map("devices")
}

// ─────────────────────────── Каталог ───────────────────────────

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id                String    @id @default(uuid()) @db.Uuid
  categoryId        String    @map("category_id") @db.Uuid
  name              String
  slug              String    @unique
  description       String?
  composition       String? // состав
  price             Int // цена в копейках
  oldPrice          Int?      @map("old_price")
  weightGrams       Int       @map("weight_grams")
  caloriesKcal      Int?      @map("calories_kcal") // на 100 г
  proteins          Float? // г на 100 г
  fats              Float?
  carbohydrates     Float?
  storageConditions String?   @map("storage_conditions")
  leadTimeHours     Int       @default(0) @map("lead_time_hours") // минимальное время на изготовление
  isActive          Boolean   @default(true) @map("is_active") // опубликован в приложении
  isFeatured        Boolean   @default(false) @map("is_featured") // показывать на главной
  inStopList        Boolean   @default(false) @map("in_stop_list")
  stopListReason    String?   @map("stop_list_reason")
  stopListUntil     DateTime? @map("stop_list_until") // автоматически вернуть в продажу
  sortOrder         Int       @default(0) @map("sort_order")
  externalId        String?   @unique @map("external_id") // GUID номенклатуры 1С
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  allergens  Allergen[]     @relation("ProductAllergens")
  orderItems OrderItem[]

  @@index([categoryId, sortOrder])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// Справочник аллергенов (глютен, молоко, яйца, орехи…)
model Allergen {
  id       String    @id @default(uuid()) @db.Uuid
  code     String    @unique
  name     String
  products Product[] @relation("ProductAllergens")

  @@map("allergens")
}

// ─────────────────────────── Доставка и слоты ───────────────────────────

model DeliveryZone {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  price            Int // стоимость доставки, коп.
  freeFromAmount   Int?     @map("free_from_amount") // бесплатно от суммы товаров
  minOrderAmount   Int      @default(0) @map("min_order_amount")
  estimatedMinutes Int?     @map("estimated_minutes")
  polygon          Json? // GeoJSON Polygon — для автоопределения зоны по координатам
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("delivery_zones")
}

// Шаблон временного интервала. Дни недели: 1 — понедельник … 7 — воскресенье.
model TimeSlot {
  id              String           @id @default(uuid()) @db.Uuid
  fulfillmentType FulfillmentType? @map("fulfillment_type") // null — для доставки и самовывоза
  startMinutes    Int              @map("start_minutes") // минуты от полуночи по Москве
  endMinutes      Int              @map("end_minutes")
  weekdays        Int[]            @default([1, 2, 3, 4, 5, 6, 7])
  capacity        Int              @default(10) // максимум заказов в интервал на дату
  isActive        Boolean          @default(true) @map("is_active")
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  orders Order[]

  @@map("time_slots")
}

// Нерабочие дни (праздники, санитарный день)
model BlackoutDate {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blackout_dates")
}

// ─────────────────────────── Промокоды ───────────────────────────

model PromoCode {
  id                    String        @id @default(uuid()) @db.Uuid
  code                  String        @unique // хранится в верхнем регистре
  description           String?
  type                  PromoCodeType
  value                 Int // процент (1–100) или сумма в копейках
  minOrderAmount        Int           @default(0) @map("min_order_amount")
  maxDiscountAmount     Int?          @map("max_discount_amount")
  startsAt              DateTime?     @map("starts_at")
  endsAt                DateTime?     @map("ends_at")
  usageLimit            Int?          @map("usage_limit")
  usageLimitPerCustomer Int?          @map("usage_limit_per_customer")
  usedCount             Int           @default(0) @map("used_count")
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  orders Order[]

  @@map("promo_codes")
}

// ─────────────────────────── Заказы ───────────────────────────

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  number          Int         @unique @default(autoincrement()) // № заказа для людей, начинается с 1001
  status          OrderStatus @default(NEW)
  accessTokenHash String      @map("access_token_hash") // SHA-256 токена доступа гостя
  customerId      String?     @map("customer_id") @db.Uuid
  deviceId        String?     @map("device_id") @db.Uuid
  source          String      @default("mobile")

  customerName  String  @map("customer_name")
  customerPhone String  @map("customer_phone")
  comment       String?

  fulfillmentType FulfillmentType @map("fulfillment_type")
  deliveryZoneId  String?         @map("delivery_zone_id") @db.Uuid
  address         String? // улица, дом
  apartment       String?
  entrance        String?
  floor           String?
  intercom        String?
  latitude        Float?
  longitude       Float?

  deliveryDate     DateTime @map("delivery_date") @db.Date
  timeSlotId       String?  @map("time_slot_id") @db.Uuid
  slotStartMinutes Int      @map("slot_start_minutes")
  slotEndMinutes   Int      @map("slot_end_minutes")

  paymentMethod  PaymentMethod @map("payment_method")
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  subtotalAmount Int           @map("subtotal_amount")
  deliveryAmount Int           @map("delivery_amount")
  discountAmount Int           @default(0) @map("discount_amount")
  totalAmount    Int           @map("total_amount")
  promoCodeId    String?       @map("promo_code_id") @db.Uuid
  promoCodeValue String?       @map("promo_code_value")

  cancelReason String? @map("cancel_reason")
  accountingId String? @map("accounting_id") // номер документа в 1С

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  paidAt      DateTime? @map("paid_at")
  confirmedAt DateTime? @map("confirmed_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  customer        Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  device          Device?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deliveryZone    DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  timeSlot        TimeSlot?            @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  promoCode       PromoCode?           @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  courierDelivery CourierDelivery?

  @@index([status, createdAt])
  @@index([deliveryDate, timeSlotId])
  @@index([customerId, createdAt])
  @@map("orders")
}

// Позиция заказа — снимок названия, цены и веса на момент покупки
model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  productName String  @map("product_name")
  imageUrl    String? @map("image_url")
  unitPrice   Int     @map("unit_price")
  weightGrams Int     @map("weight_grams")
  quantity    Int
  totalAmount Int     @map("total_amount")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actor       ActorType
  staffUserId String?      @map("staff_user_id") @db.Uuid
  comment     String?
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  provider        String // test | alfabank
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Int
  refundedAmount  Int           @default(0) @map("refunded_amount")
  externalId      String?       @map("external_id")
  confirmationUrl String?       @map("confirmation_url")
  failureReason   String?       @map("failure_reason")
  raw             Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  paidAt          DateTime?     @map("paid_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([orderId])
  @@map("payments")
}

// Заявка в курьерскую службу (Яндекс Доставка)
model CourierDelivery {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @unique @map("order_id") @db.Uuid
  provider     String // test | yandex
  externalId   String?  @map("external_id")
  status       String
  price        Int?
  trackingUrl  String?  @map("tracking_url")
  courierName  String?  @map("courier_name")
  courierPhone String?  @map("courier_phone")
  raw          Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("courier_deliveries")
}

// ─────────────────────────── Сотрудники и журналы ───────────────────────────

model StaffUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         StaffRole @default(OPERATOR)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs     AuditLog[]
  statusChanges OrderStatusHistory[]

  @@map("staff_users")
}

// История действий сотрудников
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  staffUserId String?  @map("staff_user_id") @db.Uuid
  action      String // например: order.status, product.update, promo.create
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  summary     String // человекочитаемое описание на русском
  changes     Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([staffUserId, createdAt])
  @@map("audit_logs")
}

model NotificationLog {
  id        String              @id @default(uuid()) @db.Uuid
  channel   NotificationChannel
  recipient String
  orderId   String?             @map("order_id") @db.Uuid
  title     String?
  body      String
  status    String // sent | failed | skipped
  error     String?
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([orderId])
  @@index([createdAt])
  @@map("notification_logs")
}

// Журнал обращений к внешним системам (банк, доставка, 1С)
model IntegrationLog {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  operation  String
  orderId    String?  @map("order_id") @db.Uuid
  success    Boolean
  request    Json?
  response   Json?
  error      String?
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@index([orderId])
  @@map("integration_logs")
}

// Настройки магазина (ключ — значение)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
